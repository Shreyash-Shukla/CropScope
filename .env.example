# Optional Gemini ranking. Copy this file to .env and add the real key there,
# or set GEMINI_API_KEY in the shell that runs Streamlit. Never commit .env.
GEMINI_API_KEY=

# Optional Supabase Database & Auth (PostgreSQL). If left unset, CropScope
# automatically runs in zero-setup local SQLite mode (cropscope.db).
SUPABASE_URL=
SUPABASE_ANON_KEY=
